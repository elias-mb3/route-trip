# Visualizador web (noVNC) da tela do emulador: http://localhost:6080/vnc.html
FROM docker.io/library/debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends novnc websockify && rm -rf /var/lib/apt/lists/*
CMD ["websockify", "--web", "/usr/share/novnc", "127.0.0.1:6080", "localhost:5900"]
