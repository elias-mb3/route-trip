{
  "title": "Viagem (formato 1)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "formato": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "titulo": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "subtitulo": {
      "type": "string"
    },
    "fuso": {
      "default": "America/Sao_Paulo",
      "type": "string"
    },
    "moeda": {
      "default": "BRL",
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "cores": {
      "default": {
        "tema": "#E8613C"
      },
      "type": "object",
      "properties": {
        "tema": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "required": [
        "tema"
      ],
      "additionalProperties": false
    },
    "dias": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "data": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "rotulo": {
            "type": "string",
            "minLength": 1,
            "description": "ex.: \"Sáb 14/11\""
          },
          "cor": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "paradas": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                },
                "hora": {
                  "type": "string",
                  "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                },
                "nome": {
                  "type": "string",
                  "minLength": 1
                },
                "categoria": {
                  "type": "string",
                  "enum": [
                    "passeio",
                    "refeicao",
                    "hospedagem",
                    "transporte",
                    "compras",
                    "outro"
                  ]
                },
                "obs": {
                  "type": "string"
                },
                "funcionamento": {
                  "type": "string"
                },
                "local": {
                  "type": "object",
                  "properties": {
                    "lat": {
                      "type": "number",
                      "minimum": -90,
                      "maximum": 90
                    },
                    "lng": {
                      "type": "number",
                      "minimum": -180,
                      "maximum": 180
                    },
                    "endereco": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "lat",
                    "lng"
                  ],
                  "additionalProperties": false
                },
                "foto": {
                  "type": "object",
                  "properties": {
                    "arquivo": {
                      "type": "string",
                      "pattern": "^fotos\\/[\\w.-]+\\.(webp|jpg|jpeg|png)$"
                    },
                    "url": {
                      "description": "origem da foto; o empacotador baixa e converte para fotos/<id-da-parada>.webp",
                      "type": "string",
                      "format": "uri"
                    },
                    "credito": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                },
                "links": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "rotulo": {
                        "type": "string",
                        "minLength": 1
                      },
                      "url": {
                        "type": "string",
                        "format": "uri"
                      }
                    },
                    "required": [
                      "rotulo",
                      "url"
                    ],
                    "additionalProperties": false
                  }
                },
                "fontes": {
                  "description": "de onde vieram horários, endereços e coordenadas",
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uri"
                  }
                }
              },
              "required": [
                "id",
                "nome",
                "categoria"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "data",
          "rotulo",
          "paradas"
        ],
        "additionalProperties": false
      }
    },
    "checklist": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "titulo": {
            "type": "string",
            "minLength": 1
          },
          "itens": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                },
                "texto": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "texto"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "titulo",
          "itens"
        ],
        "additionalProperties": false
      }
    },
    "orcamento": {
      "default": {
        "caixinhas": []
      },
      "type": "object",
      "properties": {
        "caixinhas": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "nome": {
                "type": "string",
                "minLength": 1
              },
              "icone": {
                "type": "string",
                "enum": [
                  "combustivel",
                  "passeios",
                  "restaurantes",
                  "hospedagem",
                  "carro",
                  "especial",
                  "compras",
                  "extras"
                ]
              },
              "cor": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "limite": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "id",
              "nome",
              "icone",
              "cor",
              "limite"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "caixinhas"
      ],
      "additionalProperties": false
    },
    "mapa": {
      "type": "object",
      "properties": {
        "bbox": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4,
          "description": "[oeste, sul, leste, norte]"
        },
        "zooms": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 19
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 19
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": [
        "bbox",
        "zooms"
      ],
      "additionalProperties": false
    },
    "contatos": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string",
            "minLength": 1
          },
          "telefone": {
            "type": "string"
          },
          "obs": {
            "type": "string"
          }
        },
        "required": [
          "nome"
        ],
        "additionalProperties": false
      }
    },
    "notas": {
      "type": "string"
    },
    "pendencias": {
      "default": [],
      "description": "dúvidas que o agente não conseguiu confirmar",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "formato",
    "id",
    "titulo",
    "dias"
  ],
  "additionalProperties": false
}
