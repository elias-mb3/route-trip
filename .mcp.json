{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "playwright": {
      "type": "stdio",
      "command": "podman",
      "args": [
        "run",
        "-i",
        "--rm",
        "--init",
        "--network=host",
        "mcr.microsoft.com/playwright/mcp",
        "--headless",
        "--browser",
        "chromium",
        "--no-sandbox"
      ],
      "env": {}
    }
  }
}